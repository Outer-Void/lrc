#!/usr/bin/env python3
"""Run LRC from a checkout without installing it: ./lrc create spec.lrc -o out"""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    raise SystemExit("LRC requires Python 3.11+")
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from lrc.cli import main  # noqa: E402

raise SystemExit(main())
