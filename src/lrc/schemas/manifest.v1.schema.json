{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:outervoid:lrc:manifest:v1",
  "title": "lrc.manifest v1 (.lrc/manifest.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "generator",
    "project",
    "templates",
    "variables",
    "entries",
    "tree_digest"
  ],
  "properties": {
    "contract": {
      "const": "lrc.manifest"
    },
    "version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "lrc"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "type"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "type": {
                "const": "dir"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "type",
              "mode",
              "sha256",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "type": {
                "const": "file"
              },
              "mode": {
                "enum": [
                  "0644",
                  "0755"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "type",
              "target"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "type": {
                "const": "symlink"
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
