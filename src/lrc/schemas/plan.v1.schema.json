{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:outervoid:lrc:plan:v1",
  "title": "lrc.plan v1 (repo.compile)",
  "type": "object",
  "required": [
    "contract",
    "version",
    "generator",
    "spec",
    "project",
    "variables",
    "templates",
    "git",
    "blux",
    "entries",
    "summary",
    "warnings",
    "tree_digest",
    "plan_id"
  ],
  "properties": {
    "contract": {
      "const": "lrc.plan"
    },
    "version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "lrc"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "git": {
      "type": "boolean"
    },
    "blux": {
      "type": [
        "object",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "origin"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      }
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linkage": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
